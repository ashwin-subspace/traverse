<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.traverse"
    android:versionCode="1"
    android:versionName="1.0">

    <application
        android:label="Traverse"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity android:name=".PathActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".TopicActivity" android:exported="false"/>
        <activity android:name=".LessonActivity" android:exported="false"/>
        <activity android:name=".QuizActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".SummaryActivity" android:exported="false"/>
    </application>
</manifest>
