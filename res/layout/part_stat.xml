<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card"
    android:paddingTop="15dp" android:paddingBottom="15dp" android:gravity="center">
    <TextView android:id="@+id/statVal" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0"
        android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text"/>
    <TextView android:id="@+id/statLbl" android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/muted" android:paddingTop="4dp"/>
</LinearLayout>
