<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/card" android:padding="16dp"
    android:layout_marginBottom="10dp">

    <FrameLayout android:layout_width="46dp" android:layout_height="46dp">
        <View android:id="@+id/tRing" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@drawable/ring"/>
        <TextView android:id="@+id/tPct" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text"/>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="14dp">
        <TextView android:id="@+id/tTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textStyle="bold" android:textColor="@color/text"/>
        <TextView android:id="@+id/tMeta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/muted" android:paddingTop="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tDue" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textStyle="bold" android:textColor="@color/warm"
        android:background="@drawable/pill" android:visibility="gone"
        android:paddingLeft="9dp" android:paddingRight="9dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"/>
</LinearLayout>
