<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="18dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/uTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textStyle="bold" android:letterSpacing="0.16" android:textColor="@color/faint"/>
    <TextView android:id="@+id/uBlurb" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="@color/muted" android:paddingTop="6dp"
        android:lineSpacingExtra="2dp"/>
</LinearLayout>
